# Copy to .env and fill in what you actually need.
# Nothing here is required to generate tracks locally with `--skip-upload`.

# ── YouTube upload / live streaming ──────────────────────────────────────────
YT_STREAM_KEY=
YT_CHANNEL_ID=

# ── LLM failsafe (opt-in only — unset means fully procedural) ───────────────
# Set to 1 to allow Groq/Gemini calls when a procedural generator fails.
LOFI_LLM_FAILSAFE=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=

# ── Optional integrations ────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YTDLP_COOKIES=
# Slack/Discord-compatible webhook, pinged after repeated stream reconnects fail.
LOFI_STREAM_ALERT_WEBHOOK=

# ── Web control panel (webui.py) ─────────────────────────────────────────────
# Mandatory if you run webui.py -- it's exposed publicly via the Cloudflare
# tunnel in deploy/setup.sh.
WEBUI_PASSWORD=
# Session-cookie signing key. Auto-generated per boot (logs everyone out on
# restart) if left unset -- set this for stable sessions.
WEBUI_SECRET=
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8080
# Public hostname reached through the Cloudflare tunnel, e.g.
# https://lofi.example.com -- used to derive the Google OAuth redirect URI.
PUBLIC_BASE_URL=
