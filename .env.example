# Copy to .env and fill in what you actually need.
# Nothing here is required to generate tracks locally with `--skip-upload`.

# ── YouTube upload / live streaming ──────────────────────────────────────────
YT_STREAM_KEY=
YT_CHANNEL_ID=

# ── Optional integrations ────────────────────────────────────────────────────
# Alert destination(s): pinged after repeated stream reconnects fail
# (scripts/stream_live.py) and on render-job / batch-queue failures
# (webui/alerts.py, via apprise). A single Slack/Discord incoming-webhook
# URL works as-is (backward compatible). For other platforms too, use a
# comma-separated list of apprise:// URLs -- see
# https://github.com/caronc/apprise/wiki for the full catalog.
LOFI_STREAM_ALERT_WEBHOOK=

# ── Playlist auto-curation (scripts/playlist_curation.py) ───────────────────
# Genre playlists: set to 1 and every upload also goes into a public playlist
# for its genre ("chillhop lofi mix · beats to study and relax to"), found by
# title or created the first time. Playlists show up in YouTube search.
YT_GENRE_PLAYLISTS=0

# Data-driven pillar -> playlist-ID assignment, replacing the old duration-only
# table. Create each playlist manually in YouTube Studio first (or via
# `python publish.py playlist create "<title>" --confirm-create`), then paste
# its ID here. Any pillar left unset here falls back to the legacy
# YT_PLAYLIST_STUDY / YT_PLAYLIST_SLEEP vars below, so you can migrate one
# pillar at a time. See scripts/playlist_curation.py's module docstring for
# the full migration path.
YT_PLAYLIST_TEMPORAL=
YT_PLAYLIST_ACTIVITY=
YT_PLAYLIST_EMOTIONAL=
YT_PLAYLIST_AESTHETIC=
YT_PLAYLIST_CROSS_GENRE=
# Legacy duration-based fallback (still honored; superseded by the pillar
# vars above once set).
YT_PLAYLIST_STUDY=
YT_PLAYLIST_SLEEP=

# ── Shorts cross-posting (scripts/generate_shorts.py) — off by default ──────
# TikTok/Instagram Reels have no first-party free upload API for this use
# case; enabling this without wiring a real provider (e.g. Ayrshare) just
# raises a clear "not implemented" error instead of faking an upload. See
# crosspost() in scripts/generate_shorts.py before setting this to 1.
CROSSPOST_ENABLED=

# ── Web control panel (webui.py) ─────────────────────────────────────────────
# Mandatory if you run webui.py -- it's exposed publicly via the Cloudflare
# tunnel in deploy/setup.sh.
WEBUI_PASSWORD=
# Session-cookie signing key. Auto-generated per boot (logs everyone out on
# restart) if left unset -- set this for stable sessions.
WEBUI_SECRET=
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8080
# Public hostname reached through the Cloudflare tunnel, e.g.
# https://lofi.example.com -- used to derive the Google OAuth redirect URI.
PUBLIC_BASE_URL=
