[Unit]
Description=Lo-fi Factory web control panel (NiceGUI)
After=network-online.target
Wants=network-online.target
# Never give up restarting (long renders/ffmpeg can wedge occasionally).
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@ROOT@
# Unbuffered stdout: prints (incl. YouTube OAuth failure diagnostics) go
# straight to the journal instead of sitting in a pipe buffer until it
# fills or the process exits.
Environment=PYTHONUNBUFFERED=1
ExecStart=@ROOT@/venv/bin/python webui.py
# webui.py loads .env itself (WEBUI_PASSWORD, PUBLIC_BASE_URL, etc.)
# `render` grants VAAPI (/dev/dri/renderD128) access for hardware video
# encoding without needing a full login-session refresh for the group
# change to take effect -- systemd applies this directly to the process.
SupplementaryGroups=render
Restart=always
RestartSec=5
# A always-on control panel shouldn't need much; capping it means a leak
# here can't take down lofi-auto's render or the rest of the box. Restart=
# already handles recovery, so MemoryMax just needs to be a safety net.
# Raised from 256M/512M: the app has grown substantially (System/Automation/
# Analytics admin pages, longitudinal analytics data) and steady-state usage
# now runs ~295-350M -- the old 256M MemoryHigh was throttling the process
# into the kernel's memory-reclaim path hard enough to make it fully
# unresponsive (confirmed via /proc/<pid>/task/*/wchan showing
# mem_cgroup_handle_over_high on the main thread, process state D).
# Renders started from the panel don't count against this: webui/jobs.py
# runs each one in its own systemd scope (WEBUI_JOB_MEMORY_MAX, default 4G).
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=default.target
