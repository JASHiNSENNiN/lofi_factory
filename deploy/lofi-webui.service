[Unit]
Description=Lo-fi Factory web control panel (NiceGUI)
After=network-online.target
Wants=network-online.target
# Never give up restarting (long renders/ffmpeg can wedge occasionally).
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/jashin/lofi_factory
ExecStart=/home/jashin/lofi_factory/venv/bin/python webui.py
# webui.py loads .env itself (WEBUI_PASSWORD, PUBLIC_BASE_URL, etc.)
# `render` grants VAAPI (/dev/dri/renderD128) access for hardware video
# encoding without needing a full login-session refresh for the group
# change to take effect -- systemd applies this directly to the process.
SupplementaryGroups=render
Restart=always
RestartSec=5
# A always-on control panel shouldn't need much; capping it means a leak
# here can't take down lofi-auto's render or the rest of the box. Restart=
# already handles recovery, so MemoryMax just needs to be a safety net.
MemoryHigh=256M
MemoryMax=512M

[Install]
WantedBy=default.target
